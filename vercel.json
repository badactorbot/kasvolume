{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx pnpm@10.33.3 install --frozen-lockfile",
  "buildCommand": "BASE_PATH=/ npx pnpm@10.33.3 --filter @workspace/kron-trading-bot run build",
  "outputDirectory": "artifacts/kron-trading-bot/dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/deploy/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
