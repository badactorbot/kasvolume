# Copy to .env and fill in. Never commit real keys.

# Solana RPC (Helius, QuickNode, Triton, public, etc.)
RPC_URL=https://api.mainnet-beta.solana.com

# Dedicated bot wallet ONLY — base58 secret key OR path to JSON keypair file
# Prefer SOLANA_PRIVATE_KEY for home/systemd EnvironmentFile, or KEYPAIR_PATH for a 0600 file.
SOLANA_PRIVATE_KEY=
# KEYPAIR_PATH=./secrets/bot-keypair.json

# Jupiter Perps API (official public base; override only if needed)
JUPITER_PERPS_API_URL=https://perps-api.jup.ag/v1

# Discord incoming webhook for alerts
DISCORD_WEBHOOK_URL=

# Safety: true = log intents only, do not sign/broadcast trade txs
DRY_RUN=true

# Risk — Rich locked 10×; wipe risk is real
MAX_LEVERAGE=10
MARKET=SOL
COLLATERAL_TOKEN=USDC
# Collateral (USDC, human units) per new entry — Jupiter min is ~$10 for new positions
COLLATERAL_USDC=10
MAX_SLIPPAGE_BPS=100
# Flatten + pause if equity drops this % from UTC day start
DAILY_LOSS_KILL_PCT=5
# Pause if equity drops this % from peak since process start
MAX_DRAWDOWN_PCT=15
# Fraction of wallet equity allowed as collateral in use (0–1)
MAX_COLLATERAL_FRACTION=0.7

# Loop
POLL_INTERVAL_MS=60000
HEARTBEAT_INTERVAL_MS=300000

# Strategy (trend + regime skeleton)
EMA_FAST=20
EMA_SLOW=50
ATR_PERIOD=14
# Min ATR% of price to treat as "trending" (skip chop)
REGIME_ATR_PCT_FLOOR=0.8
