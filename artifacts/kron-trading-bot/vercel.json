{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npx pnpm@10.33.3 install --frozen-lockfile",
  "buildCommand": "cd ../.. && npx pnpm@10.33.3 --filter @workspace/api-server run build && BASE_PATH=/ npx pnpm@10.33.3 --filter @workspace/kron-trading-bot run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
