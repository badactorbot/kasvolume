# fixture (default) exercises the mint screen without a node.
# live calls the reference commit/reveal API and Kaspa REST.
VITE_MINT_MODE=fixture

# Dev network. mainnet is refused unless this is mainnet.
VITE_KASPA_NETWORK=testnet-10

# Used when the URL has no ?id=
# VITE_COLLECTION_ID=

# Reference server from the KCC721 proposal (python3 server.py → :8112).
# Vite proxies /api/kcc721 to this origin in live mode.
VITE_MINT_API_URL=http://127.0.0.1:8112

PORT=5174
