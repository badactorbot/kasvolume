{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "node ./scripts/vercel-build.mjs",
  "outputDirectory": "artifacts/kaspa-disperse/dist/public",
  "rewrites": [
    {
      "source": "/api/app/:path*",
      "destination": "https://kasvolume.vercel.app/api/app/:path*"
    },
    {
      "source": "/api/bot/:path*",
      "destination": "https://kasvolume.vercel.app/api/bot/:path*"
    },
    {
      "source": "/api/healthz",
      "destination": "https://kasvolume.vercel.app/api/healthz"
    },
    {
      "source": "/volume-bot",
      "destination": "https://kasvolume.vercel.app/volume-bot"
    },
    {
      "source": "/volume-bot/",
      "destination": "https://kasvolume.vercel.app/volume-bot/"
    },
    {
      "source": "/volume-bot/:path*",
      "destination": "https://kasvolume.vercel.app/volume-bot/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/kron/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Accept, Content-Type" }
      ]
    }
  ],
  "functions": {
    "api/kron/token-holders/[identifier].ts": {
      "maxDuration": 60
    }
  }
}
