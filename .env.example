# Copy to a local env file or set in your shell / Vercel project. Do not commit secrets.

# --- Required: API ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kasvolume
SESSION_SECRET=generate-with-openssl-rand-base64-48
PORT=8080
NODE_ENV=development

# Shared strategy token id (not a private secret; was previously in .replit)
KRON_TOKEN_ID=bed3c81787e07988c6d5792fb02324bfd11b980a123f87a28eb177eeec6084a0

# --- Optional: API when UI and API are on different origins ---
# CORS_ORIGIN=https://your-frontend.vercel.app
# COOKIE_SAME_SITE=none

# --- Required: UI (Vite) ---
# PORT=23486
# BASE_PATH=/

# Optional absolute API origin for the browser client. Leave unset for same-origin /api
# (recommended: Vite proxy locally, Vercel rewrite in production).
# VITE_API_BASE_URL=https://your-api.vercel.app

# Optional Vite proxy target for local same-origin /api (default http://127.0.0.1:8080)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
